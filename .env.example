# ---------------------------------------------------------------------------
# Cuvasol Tutor — frontend environment template (Vite)
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# Vite only exposes VITE_-prefixed variables, and only reads .env from the
# project root. Values are inlined into the bundle at build time, so treat
# everything here as PUBLIC — never put a secret in this file.
# In production these are set in the Vercel project settings.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the /api suffix.
# Falls back to https://cuvasol-tutor.onrender.com/api if unset.
VITE_API_URL=http://localhost:5000/api

# Google Sign-In client ID (public; pairs with GOOGLE_CLIENT_ID in backend/.env).
VITE_GOOGLE_CLIENT_ID=
