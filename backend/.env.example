# ---------------------------------------------------------------------------
# Cuvasol Tutor — backend environment template
#
# Copy to backend/.env and fill in real values:   cp .env.example .env
# Loaded by dotenv in index.js ONLY when NODE_ENV !== 'production'.
# In production, set these in the Render dashboard.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database (required) ---------------------------------------------------
# MongoDB Atlas connection string. Defaults to a local mongod if unset.
MONGO_URI=mongodb://127.0.0.1:27017/teachgrow

# --- URLs ------------------------------------------------------------------
# Comma-separated CORS allowlist; also used to build links in outbound emails
# (in production the first non-localhost entry wins).
FRONTEND_URL="http://localhost:8080"

# Public origin of this backend, used to build absolute upload URLs.
# Inferred from the request host if unset.
BACKEND_URL=http://localhost:5000

# --- Auth (required in production) -----------------------------------------
# Signs all login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google Sign-In client ID (same value as VITE_GOOGLE_CLIENT_ID in root .env).
GOOGLE_CLIENT_ID=

# --- Email (Brevo / Sendinblue SMTP) ---------------------------------------
# If any of HOST/PORT/USER/PASS is missing, email sending is skipped.
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cuvasol Support <support@cuvasol.com>"

# --- Razorpay (required in production) -------------------------------------
# Use rzp_test_* keys for development. If both are absent the server refuses
# to start in production, and falls back to sandbox mock orders in dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
