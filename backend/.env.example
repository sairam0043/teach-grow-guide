# ---------------------------------------------------------------------------
# Cuvasol Tutor — backend environment template
#
# Copy to backend/.env and fill in real values:   cp .env.example .env
# Loaded by dotenv in index.js ONLY when NODE_ENV !== 'production'.
# In production, set these in the Render dashboard.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database (required) ---------------------------------------------------
# MongoDB Atlas connection string. Defaults to a local mongod if unset.
MONGO_URI=mongodb://127.0.0.1:27017/teachgrow

# --- URLs ------------------------------------------------------------------
# Comma-separated CORS allowlist; also used to build links in outbound emails
# (in production the first non-localhost entry wins).
FRONTEND_URL="http://localhost:8080"

# Public origin of this backend, used to build absolute upload URLs.
# Inferred from the request host if unset.
BACKEND_URL=http://localhost:5000

# --- Auth (required in production) -----------------------------------------
# Signs all login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google Sign-In client ID (same value as VITE_GOOGLE_CLIENT_ID in root .env).
GOOGLE_CLIENT_ID=

# --- Email (Brevo / Sendinblue SMTP) ---------------------------------------
# If any of HOST/PORT/USER/PASS is missing, email sending is skipped.
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cuvasol Support <support@cuvasol.com>"

# --- Razorpay (required in production) -------------------------------------
# Use rzp_test_* keys for development. If both are absent the server refuses
# to start in production, and falls back to sandbox mock orders in dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Payouts ---------------------------------------------------------------
# AES-256 key encrypting tutor bank account numbers at rest. Required before
# any tutor can submit payout details; the endpoint refuses rather than
# storing an account number in the clear. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENCRYPTION_KEY=

# Platform share of collected amounts, as a fraction.
# 0.10 = the current 90/10 split in the tutor's favour. 0.30 would be 70/30.
# Each payout record stores the rate actually applied, so changing this does
# not rewrite history.
PLATFORM_COMMISSION_RATE=0.10

# Payouts below this are held instead of transferred, so a tiny amount does
# not cost more in bank fees than it is worth. 0 disables the rule.
MINIMUM_PAYOUT_AMOUNT=0

# Whether a single class still marked 'enrolled' counts as delivered once its
# scheduled time has passed. Defaults to false: the clock passing is not
# evidence a class happened, and paying on that basis over-pays. Amounts held
# back this way are reported as "unconfirmed" rather than dropped.
COUNT_PAST_ENROLLED_AS_DELIVERED=false
